        "vite": "^6.4.3",
        "vitest": "^3.2.7"
    },
    "dependencies": {
        "@lucide/svelte": "^1.33.0",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "@supabase/ssr": "^0.10.3",
        "@supabase/supabase-js": "^2.112.3",
        "dotenv": "^17.4.2",
