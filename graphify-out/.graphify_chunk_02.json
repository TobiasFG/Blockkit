    },
    {
      "id": "concept_page_content_editor_invariants",
      "label": "Page content editor invariants",
      "type": "concept",
      "summary": "Page editor clones content before mutation, allows reusable references only at top level, and rejects top-level inline page blocks."
    },
    {
      "id": "concept_reusable_block_editor_invariants",
      "label": "Reusable block editor invariants",
      "type": "concept",
      "summary": "Reusable block editor mutates cloned block trees and only edits nested block fields within one reusable block root."
    },
    {
      "id": "concept_parent_based_page_paths",
      "label": "Parent-based page paths",
      "type": "concept",
      "summary": "Page paths are derived from parent links plus normalized path segments, with root pages pinned to '/'."
    },
    {
      "id": "concept_draft_publish_state",
      "label": "Draft/publish state",
      "type": "concept",
      "summary": "Page and reusable block publish state prefers explicit boolean flags, falling back to draft and published version id comparison."
    },
    {
